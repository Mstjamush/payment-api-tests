<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rotated by day, capped in total size - attach this directory when a
         run fails and the console scrollback is gone. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/payment-api-tests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>target/logs/payment-api-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Every HTTP call this suite makes goes through ApiLoggingFilter into
         this logger. INFO gives one line per call (method, URI, status,
         duration); DEBUG adds request/response bodies:
           mvn test -Dpaymentapi.log.level=DEBUG -Dpaymentapi.http.log.level=DEBUG -->
    <logger name="paymentapi" level="${paymentapi.log.level:-INFO}" />
    <logger name="paymentapi.http" level="${paymentapi.http.log.level:-INFO}" />

    <logger name="io.restassured" level="WARN" />
    <logger name="org.apache.http" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
