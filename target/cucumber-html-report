t-exist\"\n    Then the response status should be 404\n\n  @edge-case\n  Scenario: Health accepts no query parameters or body without erroring\n    Given I am not authenticated\n    And query parameter \"foo\" is \"bar\"\n    And the request body is an empty JSON object\n    When I send a GET request to \"/health/live\"\n    Then the response status should be 200\n","mediaType":"text/x.cucumber.gherkin+plain"}},{"gherkinDocument":{"uri":"file:///Users/josphatmuindi/Desktop/QA%20Folder/payment-api-tests/src/test/resources/features/health.feature","feature":{"location":{"line":1,"column":1},"tags":[],"language":"en","keyword":"Feature","name":"Health (GET /health/live, GET /health)","description":"  No authentication is required for either endpoint.","children":[{"scenario":{"location":{"line":5,"column":3},"tags":[],"keyword":"Scenario","name":"Liveness always reports UP","description":"","steps":[{"location":{"line":6,"column":5},"keyword":"Given ","keywordType":"Context","text":"I am not authenticated","id":"0548c0d5-a82f-4a80-9c73-41b75f609566"},{"location":{"line":7,"column":5},"keyword":"When ","keywordType":"Action","text":"I send a GET request to \"/health/live\"","id":"94479387-4616-4b18-a2bb-3f31401f2750"},{"location":{"line":8,"column":5},"keyword":"Then ","keywordType":"Outcome","text":"the response status should be 200","id":"450c8214-731e-480d-b8ef-c8110d23b703"},{"location":{"line":9,"column":5},"keyword":"And ","keywordType":"Conjunction","text":"the JSON response field \"status\" should equal \"UP\"","id":"23f6d8c3-5c9d-45d8-9323-eaa2dbd35e00"}],"examples":[],"id":"9bcfcf91-77b8-4e19-b237-62b55e5a2c55"}},{"scenario":{"location":{"line":11,"column":3},"tags":[],"keyword":"Scenario","name":"Readiness reports every dependency check","description":"","steps":[{"location":{"line":12,"column":5},"keyword":"Given ","keywordType":"Context","text":"I am not authenticated","id":"50d90c37-e4d9-4021-9b6c-330fdee3814c"},{"location":{"line":13,"column":5},"keyword"